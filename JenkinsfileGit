pipeline {
agent any

environment {
    GITHUB_TOKEN = credentials('github-token-actions')
    GITHUB_OWNER = 'SatriaBPY'
    GITHUB_REPO = 'Web-testing-demoblaze'
    GITHUB_API_URL = "https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}"
}

stages {

    stage('Trigger GitHub Actions') {
        steps {
            script {
                def triggerId = UUID.randomUUID().toString()
                env.TRIGGER_ID = triggerId

                echo "🚀 Triggering workflow with ID: ${triggerId}"

                sh """
                    curl -s -X POST \
                    -H "Accept: application/vnd.github+json" \
                    -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                    ${GITHUB_API_URL}/actions/workflows/playwright-test.yml/dispatches \
                    -d '{
                        "ref":"main",
                        "inputs":{
                            "branch":"main",
                            "trigger_id":"${triggerId}"
                        }
                    }'
                """
            }
        }
    }

   stage('Wait & Validate Workflow') {
        steps {
            script {
                echo "⏳ Waiting for workflow run..."
    
                def runId = null
    
                // 1) Ambil run terbaru untuk workflow ini (by file name)
                for (int i = 0; i < 30; i++) {
                    runId = sh(
                        script: '''
                            curl -s -H "Authorization: Bearer $GITHUB_TOKEN" \
                            "$GITHUB_API_URL/actions/workflows/playwright-test.yml/runs?event=workflow_dispatch&per_page=1" \
                            | jq -r '.workflow_runs[0].id // empty'
                        ''',
                        returnStdout: true
                    ).trim()
    
                    if (runId) break
    
                    echo "⏳ Run belum muncul, retry..."
                    sleep 3
                }
    
                if (!runId) {
                    error "❌ Tidak bisa menemukan run workflow"
                }
    
                env.GITHUB_RUN_ID = runId
                echo "✅ Found Run ID: ${runId}"
    
                // 2) Poll status sampai selesai
                for (int i = 0; i < 90; i++) {
    
                    def result = sh(
                        script: '''
                            curl -s -H "Authorization: Bearer $GITHUB_TOKEN" \
                            "$GITHUB_API_URL/actions/runs/$GITHUB_RUN_ID" \
                            | jq -r '.status + "|" + (.conclusion // "pending")'
                        ''',
                        returnStdout: true
                    ).trim()
    
                    def parts = result.tokenize('|')
                    def status = parts[0]
                    def conclusion = parts.size() > 1 ? parts[1].trim() : "pending"
    
                    echo "Status: ${status}, Conclusion: ${conclusion}"
    
                    if (status == "completed") {
    
                        if (conclusion != "success") {
                            error "❌ Test failed: ${conclusion}"
                        }
    
                        echo "✅ Test passed"
                        return
                    }
    
                    sleep 10
                }
    
                error "❌ Timeout waiting workflow"
            }
        }
    }

    stage('Download All Artifacts') {
        steps {
            script {
                sh "rm -rf allure-results && mkdir allure-results"

                sh """
                    curl -s -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                    "${GITHUB_API_URL}/actions/runs/${GITHUB_RUN_ID}/artifacts" \
                    | jq -r '.artifacts[].archive_download_url' \
                    | while read url; do
                        echo "Downloading artifact..."
                        curl -L -H "Authorization: Bearer ${GITHUB_TOKEN}" -o artifact.zip "$url"
                        unzip -o artifact.zip -d allure-results/
                        rm artifact.zip
                    done
                """

                sh "ls -la allure-results"
            }
        }
    }




        stage('Publish Allure Report') {
            steps {
                script {
                    echo "📊 Publishing Allure report..."

                    sh "ls -la ${WORKSPACE}/allure-results/ || true"

                    // Publish report
                    allure commandline: 'allure-cli',
                           includeProperties: false,
                           jdk: '',
                           resultPolicy: 'LEAVE_AS_IS',
                           results: [[path: 'allure-results']]

                    echo "✅ Allure report published"
                }
            }
        }
    }

    post {
        always {
            script {
                echo "🧹 Cleaning up workspace..."
                // Optional: archive results untuk debugging
            }
        }

        success {
            echo "🎉 Pipeline completed successfully!"
        }

        failure {
            echo "❌ Pipeline failed, but Allure report might still be available"
        }
    }
}
